# Public browser config (publishable/anon key is safe to expose only with correct RLS)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Server-side secrets: set in Supabase Edge Function Secrets only.
# NEVER place service-role keys or payment secrets in frontend files or commit real values.
# SUPABASE_SERVICE_ROLE_KEY=SET_IN_SUPABASE_FUNCTION_SECRETS
# MOMO_PARTNER_CODE=SET_AFTER_MERCHANT_ONBOARDING
# MOMO_ACCESS_KEY=SET_AFTER_MERCHANT_ONBOARDING
# MOMO_SECRET_KEY=SET_AFTER_MERCHANT_ONBOARDING
