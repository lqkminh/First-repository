# Public site URL and PostgreSQL
NEXT_PUBLIC_SITE_URL="https://missa.example.org"
DATABASE_URL="postgresql://missa:missa_dev_password@localhost:5432/thanh_le_missa?schema=public"

# NextAuth v4
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email magic-link provider (optional, requires SMTP)
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="Thánh Lễ Missa <no-reply@example.org>"

# Private storage (configure only when using object storage)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="missa-private"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""

# Payment provider secrets. Server-side only; never prefix with NEXT_PUBLIC_.
